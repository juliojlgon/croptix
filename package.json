{
    "name": "croptix",
    "description": "Browser extension that enhances Crunchyroll with quality selector and playback improvements",
    "author": "stratuma",
    "version": "2.0.6",
    "type": "module",
    "private": true,
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@types/bun": "1.4.4",
        "@types/node": "26.6.5",
        "@types/webextension-polyfill": "0.12.6",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "web-ext": "10.8.0",
        "webextension-polyfill": "0.12.0"
    },
    "scripts": {
        "pretty": "prettier src public scripts tests --write",
        "format:check": "prettier src public scripts tests --check",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.mjs",
        "test:browser": "playwright test",
        "build-for-amo": "bun run build:amo",
        "build:amo": "bun scripts/build.ts firefox",
        "build:v2": "bun scripts/build.ts firefox-v2",
        "build:v3": "bun scripts/build.ts chrome",
        "build:manifestv2": "bun src/utils/manifestgenv2.ts",
        "build:manifestv3": "bun src/utils/manifestgenv3.ts",
        "build:ext": "node scripts/package.mjs",
        "debug:android": "web-ext run -t firefox-android --source-dir=dist --adb-device emulator-5554 --firefox-apk org.mozilla.firefox"
    },
    "packageManager": "bun@1.4.4",
    "engines": {
        "bun": "1.4.4",
        "node": ">=22.13.0"
    }
}
