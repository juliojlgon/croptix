{
    "compilerOptions": {
        "target": "ES2021",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["bun", "node"],
        "lib": ["ES2021", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
